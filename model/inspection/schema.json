        {
          "name": "COGS",
          "expression": "SUM('Fact Transactions'[COGS])",
          "formatString": ""
        },
        {
          "name": "Gross Revenue",
          "expression": "SUM('Fact Transactions'[Gross Revenue])",
          "formatString": ""
        },
        {
          "name": "2025 COGS",
          "expression": "CALCULATE(\n    SUM('Fact Transactions'[COGS]),\n    FILTER(\n        'Fact Transactions',\n        VALUE('Fact Transactions'[Date Key]) >= 202501 &&\n        VALUE('Fact Transactions'[Date Key]) <= 202512\n    )\n)",
          "formatString": ""
        },
        {
          "name": "2025 Gross Revenue",
          "expression": "CALCULATE(\n    SUM('Fact Transactions'[Gross Revenue]),\n    FILTER(\n        'Fact Transactions',\n        VALUE('Fact Transactions'[Date Key]) >= 202501 &&\n        VALUE('Fact Transactions'[Date Key]) <= 202512\n    )\n)",
