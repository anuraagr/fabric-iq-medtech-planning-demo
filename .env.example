# Copy to .env (git-ignored) and edit. This file must NEVER contain secrets:
# authentication is interactive Microsoft Entra sign-in through the Azure CLI.

# Microsoft Entra tenant that owns the Fabric tenant you are targeting.
FPD_TENANT_ID=00000000-0000-0000-0000-000000000000

# Consistent prefix for every demo-owned resource created by the scripts.
FPD_RESOURCE_PREFIX=FabricPlanningDemo

# Dedicated demo workspace. Leave FPD_WORKSPACE_ID empty to let `deploy.py plan`
# show the creation of a new workspace named FPD_WORKSPACE_NAME (needs approval).
FPD_WORKSPACE_NAME=FabricPlanningDemo
FPD_WORKSPACE_ID=

# Existing Fabric capacity to attach the demo workspace to (GUID). Never created
# or resized by these scripts. Leave empty to be prompted by `preflight.py`.
FPD_CAPACITY_ID=

# Optional per-deployment manifest. Relative paths are resolved from the repository root.
# Never point at another tenant's manifest; it will be rejected.
FPD_MANIFEST_PATH=state/deployment-manifest.json

# Optional: isolated Azure CLI profile so the demo does not disturb your default
# `az` account, e.g.  az login --tenant <tenant> --use-device-code
# AZURE_CONFIG_DIR=C:\Users\you\.azure-fabricplanningdemo
AZURE_CONFIG_DIR=

# Set to 1 to enable live (tenant-touching, read-only unless noted) pytest checks.
FPD_LIVE=0
